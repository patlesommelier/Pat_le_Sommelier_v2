# ── Base de données ──
# Netlify Database : aucune variable à renseigner, la connexion (NETLIFY_DB_URL) est fournie par Netlify
# en production et par `netlify dev` en local. Les données sont chargées par les migrations
# de netlify/database/migrations (voir npm run import).

# ── Pat (API Claude, console.anthropic.com) ──
ANTHROPIC_API_KEY=
# Modèle utilisé par Pat (à ajuster selon les modèles disponibles sur votre compte)
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Démo ──
# true = affiche aussi les accords « proposés » (pas encore validés par le sommelier)
AFFICHER_ACCORDS_PROPOSES=true
