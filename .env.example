# ── Base de données Supabase ──
# Supabase > Project Settings > Database > Connection string > « Transaction pooler » (port 6543).
# Utilisée par l'app (pages et API, côté serveur uniquement) et par les scripts d'import.
# Sur Netlify : à ajouter dans Site configuration › Environment variables (sinon l'app ne trouve pas sa base).
# Projet Supabase : ykbthpgmcqtoolrnkdsd (eu-west-1). Seul MOT_DE_PASSE est à remplacer, par le mot de passe de la base
# (Supabase › Project Settings › Database › Reset database password si besoin).
DATABASE_URL=postgresql://postgres.ykbthpgmcqtoolrnkdsd:MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ── Migration ponctuelle depuis Netlify Database (npm run copier-vers-supabase) ──
# Chaîne de connexion de l'ancienne base Netlify Database, lue seulement. À retirer une fois la copie faite.
NETLIFY_DB_URL=

# ── Pat (API Claude, console.anthropic.com) ──
ANTHROPIC_API_KEY=
# Modèle utilisé par Pat (à ajuster selon les modèles disponibles sur votre compte)
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Démo ──
# true = affiche aussi les accords « proposés » (pas encore validés par le sommelier)
AFFICHER_ACCORDS_PROPOSES=true
