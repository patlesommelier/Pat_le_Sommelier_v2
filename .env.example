# ── Base de données Supabase ──
# Supabase > Project Settings > Database > Connection string > « Transaction pooler » (port 6543).
# Utilisée par l'app (pages et API, côté serveur uniquement) et par les scripts d'import.
DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── Pat (API Claude, console.anthropic.com) ──
ANTHROPIC_API_KEY=
# Modèle utilisé par Pat (facultatif : claude-opus-5-5 par défaut)
ANTHROPIC_MODEL=claude-opus-5-5
# Passe rapide de l'inscription : premiers accords d'un nouveau restaurant (facultatif : claude-sonnet-5-5 par défaut)
ANTHROPIC_MODEL_RAPIDE=claude-sonnet-5-5

# ── Démo ──
# true = affiche aussi les accords « proposés » (pas encore validés par le sommelier)
AFFICHER_ACCORDS_PROPOSES=true

# ── Wine Labs (étiquettes) ──
# Clé d'API Wine Labs (Authorization: Bearer …). À mettre dans Netlify, jamais dans le code.
WINE_LABS_API_KEY=
# Facultatif : le webhook se branche depuis super-admin > Wine Labs (secret gardé en base).
# Sinon, secret de signature (whsec_…) du webhook enregistré chez Wine Labs : https://<votre-site>.netlify.app/api/webhooks/wine-labs
WINE_LABS_WEBHOOK_SECRET=
# Facultatif : nombre maximal de demandes par recherche (80 par défaut).
WINE_LABS_MAX_PAR_LOT=

# ── Back-office (Supabase Auth et stockage des images) ──
# Supabase > Project Settings > API : « Project URL », clé « anon public » et clé « service_role » (secrète).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Adresses e-mail des administrateurs (Pat), séparées par des virgules : ils voient tous les restaurants.
PAT_ADMIN_EMAILS=
# Adresse publique de l'app, utilisée par le QR code (sinon : l'adresse du site appelé)
URL_PUBLIQUE=https://coruscating-frangollo-729fdd.netlify.app
# Développement local uniquement, sans Supabase : se connecter automatiquement avec cet e-mail (admin).
# Ignoré sur Netlify et dès que Supabase est configuré.
# AUTH_DEV_EMAIL=pat@exemple.be
